# ============================================================
# AI-Powered Personal Nutrition & Energy Balance Coach
# Environment Variables Configuration
# ============================================================

# App Settings
APP_NAME="AI Nutrition & Energy Balance Coach"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# For production (PostgreSQL with pgvector):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nutrition_db"
# For local development / testing fallback:
DATABASE_URL="sqlite:///./nutrition_dev.db"

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Coach & LLM Configuration
# Options: "gemini", "openai", "local_heuristic"
LLM_PROVIDER="openrouter"
LLM_API_KEY=""
LLM_API_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="openai/gpt-4o-mini"
LLM_TEMPERATURE=0.2

# Embedding & Vector RAG Configuration
# Options: "gemini", "openai", "sentence_transformers", "cosine_tfidf"
EMBEDDING_PROVIDER="cosine_tfidf"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"

# Speech-to-Text (STT) Configuration
# Options: "native_android" (client-side), "gemini_audio", "whisper_api"
STT_PROVIDER="native_android"
STT_API_KEY=""

# Data Paths
# Defaults to the repository's DATASET/INDB directory.
# INDB_DATASET_DIR="/path/to/authorized/INDB/data"

# Proactive Notification Settings
DEFAULT_QUIET_HOURS_START="22:00"
DEFAULT_QUIET_HOURS_END="07:00"
DEFAULT_BREAKFAST_REMINDER_TIME="09:30"
DEFAULT_LUNCH_REMINDER_TIME="14:00"
DEFAULT_DINNER_REMINDER_TIME="21:00"
